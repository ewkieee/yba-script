-- FLY
-- =============================================
local flyConn, bodyVel, bodyGyro

local function startFly()
    if bodyVel then return end
    bodyVel = Instance.new("BodyVelocity")
    bodyVel.MaxForce = Vector3.new(1e5,1e5,1e5)
    bodyVel.Velocity = Vector3.zero
    bodyVel.Parent = root
    bodyGyro = Instance.new("BodyGyro")
    bodyGyro.MaxTorque = Vector3.new(1e5,1e5,1e5)
    bodyGyro.D = 100
    bodyGyro.Parent = root
    flyConn = RunService.RenderStepped:Connect(function()
        if not State.fly then return end
        local d = Vector3.zero
        if UserInputService:IsKeyDown(Enum.KeyCode.W) then d = d + cam.CFrame.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then d = d - cam.CFrame.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then d = d - cam.CFrame.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then d = d + cam.CFrame.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.Space) then d = d + Vector3.new(0,1,0) end
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then d = d - Vector3.new(0,1,0) end
        bodyVel.Velocity = d.Magnitude > 0 and d.Unit * State.flySpeed or Vector3.zero
        bodyGyro.CFrame = cam.CFrame
    end)
end

local function stopFly()
    if flyConn then flyConn:Disconnect() flyConn = nil end
    if bodyVel then bodyVel:Destroy() bodyVel = nil end
    if bodyGyro then bodyGyro:Destroy() bodyGyro = nil end
end

-- =============================================
-- AUTO FARM ITEMS
-- =============================================
local function isItemWanted(name)
    if not name or name == "" then return false end
    if next(State.farmItems) == nil then return true end
    return State.farmItems[name] == true
end

local function findNearestItem()
    local best, bestDist = nil, math.huge
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("ProximityPrompt") then
            local act = obj.ActionText:lower()
            if act:find("pick") or act:find("grab") then
                local name = obj.ObjectText
                if isItemWanted(name) then
                    local part = obj.Parent
                    local pos
                    if part:IsA("BasePart") then pos = part.Position
                    elseif part:IsA("Model") then
                        pcall(function() pos = part:GetPivot().Position end)
                    end
                    if pos then
                        local d = (root.Position - pos).Magnitude
                        if d < bestDist then bestDist = d; best = {prompt=obj,pos=pos} end
                    end
                end
            end
        end
    end
    return best
end

-- =============================================
-- AUTO SELL (ShiftPlox)
-- =============================================
local sellCooldown = false

local function findMerchantPrompt()
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("ProximityPrompt") then
            local t = (obj.ObjectText or ""):lower()
            local a = (obj.ActionText or ""):lower()
            if t:find("shiftplox") or t:find("merchant") or a:find("sell") or a:find("talk") then
                local part = obj.Parent
                local pos
                if part:IsA("BasePart") then pos = part.Position
                elseif part:IsA("Model") then pcall(function() pos = part:GetPivot().Position end) end
                if pos then return {prompt=obj, pos=pos} end
            end
        end
    end
    return nil
end

local function doSell()
    if sellCooldown then return end
    local m = findMerchantPrompt()
    if not m then return end
    sellCooldown = true
    -- подходим к мерчанту
    if (root.Position - m.pos).Magnitude > 7 then
        root.CFrame = CFrame.new(m.pos + Vector3.new(0,4,0))
        task.wait(0.5)
    end
    pcall(function() fireproximityprompt(m.prompt) end)
    task.wait(2)
    sellCooldown = false
end

-- =============================================
-- STAND FARM (Auto Arrow)
-- =============================================
local function getCurrentStand()
    local paths = {
        function() return plr.leaderstats.Stand.Value end,
        function() return plr.Data.Stand.Value end,
        function() return plr:FindFirstChild("Stand") and plr.Stand.Value end,
    }
    for _, fn in ipairs(paths) do
        local ok, v = pcall(fn)
        if ok and v and v ~= "" and v ~= "None" then return v end
    end
    return nil
end

local function shouldKeepStand(name)
    if not name then return false end
    return State.standKeepList[name] == true
end

local function findUseArrowBtn()
    for _, gui in ipairs(plr.PlayerGui:GetDescendants()) do
        if gui:IsA("TextButton") then
            local t = gui.Text:lower()
            if t:find("use") then
                local p = gui.Parent
                if p then
                    for _, c in ipairs(p:GetDescendants()) do
                        if c:IsA("TextLabel") or c:IsA("StringValue") then
                            local ct = tostring(c.Text or c.Value):lower()
                            if ct:find("arrow") then return gui end
                        end
                    end
                end
            end
        end
    end
    return nil
end

-- =============================================
-- ITEM ESP
-- =============================================
local espLabels = {}

local function clearESP()
    for _, v in pairs(espLabels) do pcall(function() v:Destroy() end) end
    espLabels = {}
end

local function updateItemESP()
    clearESP()
    if not State.itemESP then return end
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("ProximityPrompt") then
            local act = obj.ActionText:lower()
            if act:find("pick") or act:find("grab") then
                local part = obj.Parent
                if part:IsA("BasePart") or part:IsA("Model") then
                    local bb = Instance.new("BillboardGui")
                    bb.AlwaysOnTop = true
                    bb.Size = UDim2.new(0, 100, 0, 30)
                    bb.StudsOffset = Vector3.new(0, 3, 0)
                    bb.Adornee = part:IsA("BasePart") and part or part.PrimaryPart
                    if bb.Adornee then
                        bb.Parent = workspace
                        local lbl = Instance.new("TextLabel")
                        lbl.Size = UDim2.new(1,0,1,0)
                        lbl.BackgroundTransparency = 1
                        lbl.Text = obj.ObjectText
                        lbl.TextColor3 = Color3.fromRGB(255,220,50)
                        lbl.TextSize = State.itemESPSize
                        lbl.Font = Enum.Font.GothamBold
                        lbl.TextStrokeTransparency = 0
                        lbl.Parent = bb
                        table.insert(espLabels, bb)
                    end
                end
            end
        end
    end
end

