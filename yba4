-- =============================================
local function stealMoney()
    if not State.stealMoney then return end
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("ProximityPrompt") then
            local t = (obj.ObjectText or ""):lower()
            local a = (obj.ActionText or ""):lower()
            if t:find("money") or t:find("yen") or a:find("money") then
                local part = obj.Parent
                local pos
                if part:IsA("BasePart") then pos = part.Position
                elseif part:IsA("Model") then pcall(function() pos = part:GetPivot().Position end) end
                if pos then
                    local dist = (root.Position - pos).Magnitude
                    if dist < 50 then
                        pcall(function() fireproximityprompt(obj) end)
                    end
                end
            end
        end
    end
end

-- =============================================
-- MAIN LOOP
-- =============================================
local farmTimer = 0
local espTimer = 0
local sellTimer = 0

RunService.Heartbeat:Connect(function(dt)
    if not char or not root then return end

    farmTimer = farmTimer + dt
    espTimer = espTimer + dt
    sellTimer = sellTimer + dt

    -- Auto Farm
    if State.farmEnabled and farmTimer > 0.05 then
        farmTimer = 0
        local item = findNearestItem()
        if item then
            local dist = (root.Position - item.pos).Magnitude
            if dist > 5 then
                root.CFrame = CFrame.new(
                    root.Position:Lerp(item.pos + Vector3.new(0, 2, 0), 0.3)
                )
            else
                pcall(function() fireproximityprompt(item.prompt) end)
            end
        end
    end

    -- Auto Sell (каждые 8 сек)
    if State.autoSell and sellTimer > 8 then
        sellTimer = 0
        task.spawn(doSell)
    end

    -- Steal Money
    if State.stealMoney and farmTimer == 0 then
        stealMoney()
    end

    -- Item ESP update (каждые 2 сек)
    if espTimer > 2 then
        espTimer = 0
        task.spawn(updateItemESP)
    end
end)

-- Stand Farm loop
task.spawn(function()
    while true do
        task.wait(0.8)
        if not State.standFarmEnabled then continue end
        local stand = getCurrentStand()
        if shouldKeepStand(stand) then
            State.standFarmEnabled = false
            pcall(function()
                StarterGui:SetCore("SendNotification", {
                    Title = "YBA Hub",
                    Text = "✓ Получен стенд: " .. (stand or "?"),
                    Duration = 8,
                })
            end)
            -- обновляем кнопку в GUI
            continue
        end
        local btn = findUseArrowBtn()
        if btn then
            pcall(function() btn:Invoke() end)
            task.wait(1)
        end
    end
end)

