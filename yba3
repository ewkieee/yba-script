-- Fly
local function startFly()
    if flying then return end
    flying = true
    bodyVel = Instance.new("BodyVelocity")
    bodyVel.Velocity = Vector3.zero
    bodyVel.MaxForce = Vector3.new(1e5, 1e5, 1e5)
    bodyVel.Parent = root
    bodyGyro = Instance.new("BodyGyro")
    bodyGyro.MaxTorque = Vector3.new(1e5, 1e5, 1e5)
    bodyGyro.D = 100
    bodyGyro.Parent = root
    flyConn = RunService.RenderStepped:Connect(function()
        if not flying then return end
        local cam = workspace.CurrentCamera
        local dir = Vector3.zero
        if UserInputService:IsKeyDown(Enum.KeyCode.W) then dir = dir + cam.CFrame.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then dir = dir - cam.CFrame.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then dir = dir - cam.CFrame.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then dir = dir + cam.CFrame.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.Space) then dir = dir + Vector3.new(0,1,0) end
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then dir = dir - Vector3.new(0,1,0) end
        bodyVel.Velocity = dir.Magnitude > 0 and dir.Unit * cfg.FlySpeed or Vector3.zero
        bodyGyro.CFrame = cam.CFrame
    end)
end

local function stopFly()
    flying = false
    if flyConn then flyConn:Disconnect() flyConn = nil end
    if bodyVel then bodyVel:Destroy() bodyVel = nil end
    if bodyGyro then bodyGyro:Destroy() bodyGyro = nil end
end

-- ============================================
-- АВТО ФАРМ С ФИЛЬТРОМ
-- ============================================

local function isItemWanted(name)
    if ITEM_BLACKLIST[name] then return false end
    -- если вайтлист пустой — берём всё кроме блеклиста
    local hasWhitelist = next(ITEM_WHITELIST) ~= nil
    if hasWhitelist then
        return ITEM_WHITELIST[name] == true
    end
    return true
end

local function findNearestPrompt()
    local nearest = nil
    local nearestDist = math.huge
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("ProximityPrompt") then
            local objText = obj.ObjectText
            local actionText = obj.ActionText:lower()
            -- только подбор, не другие промпты
            if actionText:find("pick") or actionText:find("grab") then
                if isItemWanted(objText) then
                    local part = obj.Parent
                    local pos
                    if part:IsA("Model") then
                        pcall(function() pos = part:GetPivot().Position end)
                    elseif part:IsA("BasePart") then
                        pos = part.Position
                    end
                    if pos then
                        local dist = (root.Position - pos).Magnitude
                        if dist < nearestDist then
                            nearestDist = dist
                            nearest = {prompt = obj, pos = pos}
                        end
                    end
                end
            end
        end
    end
    return nearest
end

-- ============================================
-- АВТО ПРОДАЖА — ShiftPlox
-- ============================================

-- ShiftPlox находится в Merchant's Keep
-- ищем его по имени в workspace
local function findShiftPlox()
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("ProximityPrompt") then
            local txt = (obj.ObjectText or ""):lower()
            local act = (obj.ActionText or ""):lower()
            if txt:find("shift") or txt:find("merchant") or act:find("sell") then
                local part = obj.Parent
                local pos
                if part:IsA("BasePart") then pos = part.Position
                elseif part:IsA("Model") then pcall(function() pos = part:GetPivot().Position end) end
                if pos then return {prompt = obj, pos = pos} end
            end
        end
    end
    return nil
end

local sellCooldown = false

local function doAutoSell()
    if sellCooldown then return end
    local merchant = findShiftPlox()
    if not merchant then return end
    sellCooldown = true

    -- летим к мерчанту
    local dist = (root.Position - merchant.pos).Magnitude
    if dist > 8 then
        root.CFrame = CFrame.new(merchant.pos + Vector3.new(0, 3, 0))
        task.wait(0.3)
    end

    -- открываем промпт
    pcall(function()
        fireproximityprompt(merchant.prompt)
    end)

    task.wait(3) -- ждём пока UI продажи откроется
    sellCooldown = false
end

-- ============================================
-- АВТО ОТКРЫТИЕ СТРЕЛЛ
-- ============================================

local function getCurrentStand()
    -- YBA хранит стенд в leaderstats или custom value
    local stats = plr:FindFirstChild("leaderstats")
    if stats then
        local stand = stats:FindFirstChild("Stand")
        if stand then return stand.Value end
    end
    -- альтернативный путь
    local data = plr:FindFirstChild("Data")
    if data then
        local stand = data:FindFirstChild("Stand")
        if stand then return stand.Value end
    end
    return nil
end

local function shouldKeepStand(standName)
    if not standName or standName == "" or standName == "None" then return false end
    return KEEP_STANDS[standName] == true
end

local function findArrowPrompt()
    -- ищем стрелу в инвентаре или на земле — YBA использует GUI для открытия
    -- ищем кнопку Use в inventory GUI
    local playerGui = plr.PlayerGui
    for _, gui in ipairs(playerGui:GetDescendants()) do
        if gui:IsA("TextButton") then
            local txt = gui.Text:lower()
            if txt:find("use") or txt:find("open") then
                -- проверяем что это стрела
                local parent = gui.Parent
                if parent then
                    local itemLabel = parent:FindFirstChild("ItemName") or parent:FindFirstChild("Name")
                    if itemLabel and (tostring(itemLabel.Text):lower():find("arrow") or
                                     tostring(itemLabel.Text):lower():find("mysterious")) then
                        return gui
                    end
                end
            end
        end
    end
    return nil
end

