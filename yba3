-- ГЛАВНЫЙ ЛУП
-- ============================================

local farmState = "idle" -- idle, farming, selling, arrowing

RunService.Heartbeat:Connect(function()
    if not char or not root then return end

    -- Авто фарм
    if autoFarm and farmState == "idle" then
        local item = findNearestPrompt()
        if item then
            local dist = (root.Position - item.pos).Magnitude
            if dist > 6 then
                root.CFrame = CFrame.new(
                    root.Position:Lerp(item.pos + Vector3.new(0, 2, 0), 0.25)
                )
            else
                pcall(function()
                    fireproximityprompt(item.prompt)
                end)
            end
        end
    end

    -- Авто продажа (каждые 10 секунд)
    if autoSell and farmState == "idle" and not sellCooldown then
        doAutoSell()
    end
end)

-- Авто стрела — запускаем в отдельном луп через task.spawn
task.spawn(function()
    while true do
        task.wait(1)
        if not autoArrow then continue end

        local currentStand = getCurrentStand()

        if shouldKeepStand(currentStand) then
            -- стенд хороший, не трогаем
            continue
        end

        -- ищем кнопку Use Arrow в GUI
        local btn = findArrowPrompt()
        if btn then
            pcall(function()
                btn:Invoke()
            end)
            task.wait(1)
            -- проверяем новый стенд
            local newStand = getCurrentStand()
            if shouldKeepStand(newStand) then
                -- нашли хороший стенд!
                game:GetService("StarterGui"):SetCore("SendNotification", {
                    Title = "YBA Hub",
                    Text = "Получен стенд: " .. (newStand or "?"),
                    Duration = 5
                })
                autoArrow = false -- останавливаем
            end
        end
    end
end)

