local flying = false
local noclip = false
local autoFarm = false
local flyConn = nil
local bodyVel = nil
local bodyGyro = nil

local cfg = {
    WalkSpeed = 100,
    JumpPower = 120,
    FlySpeed = 150,
    AutoFarmRadius = 20, -- proximity prompt trigger distance
}

-- Character refresh
plr.CharacterAdded:Connect(function(c)
    char = c
    root = c:WaitForChild("HumanoidRootPart")
    hum = c:WaitForChild("Humanoid")
    -- reapply speed on respawn
    task.wait(0.5)
    applySpeed()
end)

-- WalkSpeed через BodyVelocity workaround не нужен —
-- YBA позволяет менять speed если делать это правильно
function applySpeed()
    if hum then
        hum.WalkSpeed = cfg.WalkSpeed
        hum.JumpPower = cfg.JumpPower
    end
end

-- Постоянно форсим скорость каждый кадр
RunService.Heartbeat:Connect(function()
    if hum and hum.Parent then
        hum.WalkSpeed = cfg.WalkSpeed
        hum.JumpPower = cfg.JumpPower
    end
end)

-- NoClip
RunService.Stepped:Connect(function()
    if noclip and char then
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = false
            end
        end
    end
end)

-- Fly
local function startFly()
    if flying then return end
    flying = true

    bodyVel = Instance.new("BodyVelocity")
    bodyVel.Velocity = Vector3.zero
    bodyVel.MaxForce = Vector3.new(1e5, 1e5, 1e5)
    bodyVel.Parent = root

    bodyGyro = Instance.new("BodyGyro")
    bodyGyro.MaxTorque = Vector3.new(1e5, 1e5, 1e5)
    bodyGyro.D = 100
    bodyGyro.Parent = root

    flyConn = RunService.RenderStepped:Connect(function()
        if not flying then return end
        local cam = workspace.CurrentCamera
        local dir = Vector3.zero

        if UserInputService:IsKeyDown(Enum.KeyCode.W) then
            dir = dir + cam.CFrame.LookVector
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then
            dir = dir - cam.CFrame.LookVector
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then
            dir = dir - cam.CFrame.RightVector
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then
            dir = dir + cam.CFrame.RightVector
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.Space) then
            dir = dir + Vector3.new(0, 1, 0)
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then
            dir = dir - Vector3.new(0, 1, 0)
        end

        bodyVel.Velocity = dir.Magnitude > 0 and dir.Unit * cfg.FlySpeed or Vector3.zero
        bodyGyro.CFrame = cam.CFrame
    end)
end

local function stopFly()
    flying = false
    if flyConn then flyConn:Disconnect() flyConn = nil end
    if bodyVel then bodyVel:Destroy() bodyVel = nil end
    if bodyGyro then bodyGyro:Destroy() bodyGyro = nil end
end

-- Auto Farm — ищет ProximityPrompt в workspace
-- YBA использует ProximityPrompt с ActionText "Pick Up" или ObjectText = название предмета
local function findNearestPrompt()
    local nearest = nil
    local nearestDist = math.huge

    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("ProximityPrompt") then
            -- фильтр по YBA предметам
            local actionText = obj.ActionText:lower()
            local objText = obj.ObjectText:lower()
            if actionText:find("pick") or actionText:find("grab") or
               objText:find("arrow") or objText:find("stand") or
               objText:find("disc") or objText:find("item") or
               objText:find("rokaka") or objText:find("vampire") or
               objText:find("steel") or objText:find("stone") then
                local part = obj.Parent
                if part:IsA("BasePart") or part:IsA("Model") then
                    local pos
                    if part:IsA("Model") then
                        pos = part:GetPivot().Position
                    else
                        pos = part.Position
                    end
                    local dist = (root.Position - pos).Magnitude
                    if dist < nearestDist then
                        nearestDist = dist
                        nearest = {prompt = obj, pos = pos, dist = dist}
                    end
                end
            end
        end
    end
    return nearest
end

local farmConn = nil

local function startFarm()
    if farmConn then farmConn:Disconnect() end
    farmConn = RunService.Heartbeat:Connect(function()
        if not autoFarm then return end
        if not char or not root then return end

        local item = findNearestPrompt()
        if not item then return end

        local dist = (root.Position - item.pos).Magnitude

        if dist > 8 then
            -- летим к предмету
            root.CFrame = CFrame.new(
                root.Position:Lerp(item.pos + Vector3.new(0, 3, 0), 0.3)
            )
        else
            -- триггерим ProximityPrompt напрямую
            fireproximityprompt(item.prompt)
        end
    end)
end

startFarm()

